{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ukchucktown/agent-skills/schemas/machine-config.schema.json",
  "title": "SDLC machine profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkoutRoot", "worktreeRoot", "worktreeManager"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checkoutRoot": { "type": "string", "minLength": 1 },
    "worktreeRoot": { "type": "string", "minLength": 1 },
    "worktreeManager": { "enum": ["supacode", "git"] },
    "skillSourceRoot": { "type": "string", "minLength": 1 },
    "instructionSource": { "type": "string", "minLength": 1 },
    "lampwrightStateRoot": { "type": "string", "minLength": 1 },
    "harnesses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": { "$ref": "#/$defs/harness" },
        "claude": { "$ref": "#/$defs/harness" },
        "copilot": { "$ref": "#/$defs/harness" }
      }
    },
    "executables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git": { "type": "string", "minLength": 1 },
        "github": { "type": "string", "minLength": 1 },
        "supacode": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillRoot", "instructionFile"],
      "properties": {
        "skillRoot": { "type": "string", "minLength": 1 },
        "instructionFile": { "type": "string", "minLength": 1 }
      }
    }
  }
}
