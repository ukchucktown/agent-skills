{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ukchucktown/agent-skills/schemas/repository-config.schema.json",
  "title": "SDLC repository configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "provider",
    "stableBranch",
    "integrationBranchPattern",
    "childBranchPattern",
    "worktreeRetention",
    "childMergeMethod",
    "featureMergeMethod",
    "validationSetupCommands",
    "childValidationCommands",
    "featureValidationCommands",
    "finalMergeApproval",
    "featureLabel",
    "childLabel",
    "readyLabel"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "const": "github" },
    "stableBranch": { "type": "string", "minLength": 1 },
    "integrationBranchPattern": {
      "type": "string",
      "pattern": "\\{issue\\}.*\\{slug\\}|\\{slug\\}.*\\{issue\\}"
    },
    "childBranchPattern": {
      "type": "string",
      "pattern": "\\{issue\\}.*\\{slug\\}|\\{slug\\}.*\\{issue\\}"
    },
    "worktreeRetention": { "const": "feature" },
    "closeChildOnIntegrationMerge": { "type": "boolean" },
    "autoMergeChildPullRequests": { "type": "boolean" },
    "childMergeMethod": { "enum": ["merge", "squash", "rebase"] },
    "featureMergeMethod": { "enum": ["merge", "squash", "rebase"] },
    "validationSetupCommands": { "$ref": "#/$defs/validationCommands" },
    "childValidationCommands": { "$ref": "#/$defs/validationCommands" },
    "featureValidationCommands": { "$ref": "#/$defs/validationCommands" },
    "finalMergeApproval": { "const": "required" },
    "featureLabel": { "type": "string", "minLength": 1 },
    "childLabel": { "type": "string", "minLength": 1 },
    "readyLabel": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "validationCommands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executable", "args"],
        "properties": {
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
