{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ukchucktown/agent-skills/schemas/action-plan.schema.json",
  "title": "Reviewable SDLC action plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "operation", "evidence", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operation": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "object",
      "required": ["stateFingerprint"],
      "properties": {
        "stateFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "adapter", "operation", "parameters"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "adapter": { "enum": ["github", "git", "worktree", "filesystem"] },
          "operation": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object" }
        }
      }
    }
  }
}
