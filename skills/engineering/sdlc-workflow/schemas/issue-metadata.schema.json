{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ukchucktown/agent-skills/schemas/issue-metadata.schema.json",
  "title": "Normalized GitHub issue metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "number", "role", "state", "title", "labels", "blockedBy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "number": { "type": "integer", "minimum": 1 },
    "role": { "enum": ["feature", "child"] },
    "state": { "enum": ["open", "closed"] },
    "title": { "type": "string" },
    "parent": { "type": "integer", "minimum": 1 },
    "labels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "assignees": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "blockedBy": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "branch": { "type": "string" },
    "disposition": { "enum": ["completed", "cancelled"] },
    "pullRequest": {
      "type": "object",
      "required": ["number", "state", "base", "head", "headSha"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["open", "closed", "merged"] },
        "base": { "type": "string" },
        "head": { "type": "string" },
        "headSha": { "type": "string" },
        "checks": { "enum": ["pending", "passing", "failing"] },
        "review": { "enum": ["pending", "approved", "changes_requested"] }
      }
    }
  }
}
